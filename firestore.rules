rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 운영진 = admins 컬렉션에 본인 uid 문서가 있는 계정. 문서는 콘솔에서만 만든다(클라이언트 쓰기 불가).
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // 부원: 본인 문서만 읽고 쓴다. 운영진: 요약 문서(users/{uid})만 읽는다.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'photo', 'lastActive', 'summary', 'prob']);
      allow delete: if false;

      // 풀이 기록·작성 중인 코드는 본인만 접근한다(운영진도 읽지 못함).
      match /data/{doc} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && (doc == 'state' || doc == 'work')
          && request.resource.data.keys().hasOnly(['json']);
        allow delete: if false;
      }
    }

    // 이번 주 과제: 로그인한 누구나 읽고, 운영진만 weekly 문서를 쓴다.
    match /config/{doc} {
      allow read: if signedIn();
      allow create, update: if isAdmin() && doc == 'weekly'
        && request.resource.data.keys().hasOnly(['title', 'note', 'stages', 'due', 'at'])
        && request.resource.data.title.size() <= 60
        && request.resource.data.note.size() <= 200
        && request.resource.data.stages.size() <= 30;
      allow delete: if false;
    }

    // 채점 오류 신고: 로그인한 누구나 본인 이름으로 작성, 운영진만 읽고 처리 상태를 바꾼다.
    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'at', 'status', 'pid', 'title', 'note', 'code', 'fails'])
        && request.resource.data.status == 'open'
        && request.resource.data.code.size() <= 6000
        && request.resource.data.note.size() <= 200;
      allow read: if isAdmin();
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }
  }
}
